# Banco de dados (opcional em desenvolvimento — sem essas variáveis, o app
# usa automaticamente um arquivo SQLite local em ./data/crias-party.db)
#
# Para produção (Vercel ou qualquer ambiente serverless), crie um banco no
# Turso (https://turso.tech, plano gratuito disponível) e preencha:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Senha do painel administrativo (/admin). Troque para algo só seu antes de
# publicar o app — o valor padrão "crias-admin-2024" é público (está no
# código-fonte) e não deve ser usado em produção.
ADMIN_SECRET=
